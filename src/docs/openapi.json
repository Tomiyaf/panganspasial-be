        "responses": { "200": { "description": "Daftar user admin" } }
      },
      "post": {
        "tags": ["Admin Users & Summary"],
        "summary": "Tambah User Admin Baru",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
