        "responses": { "200": { "description": "Daftar sub-jenis ternak" } }
      }
    },
    "/admin/validations": {
      "get": {
        "tags": ["Data Validations"],
        "summary": "Daftar Histori Validasi Data Survey",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "valid", "rejected"] } },
          { "name": "entity_type", "in": "query", "schema": { "type": "string", "enum": ["farm", "livestock"] } }
        ],
        "responses": { "200": { "description": "Histori validasi data" } }
      },
      "post": {
        "tags": ["Data Validations"],
        "summary": "Buat Catatan Validasi Data Baru",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationInput" } } }
        },
        "responses": { "201": { "description": "Catatan validasi berhasil dibuat" } }
      }
    },
    "/admin/validations/{id}": {
      "patch": {
        "tags": ["Data Validations"],
        "summary": "Update Status Validasi (Approve / Reject)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "valid", "rejected"] },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Status validasi berhasil diperbarui" } }
      }
    },
