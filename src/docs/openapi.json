        "responses": { "200": { "description": "Summary total peternakan, validasi pending, dan update terkini" } }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin Users & Summary"],
        "summary": "Daftar Administrator Sistem",
